<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net46</TargetFramework>
		<!--The runner loads every InGameTests.*.dll next to it, in test mode only-->
		<AssemblyName>InGameTests.FastForward</AssemblyName>
		<RootNamespace>InGameTests.FastForward</RootNamespace>
		<Description>In-game checks of FastForward, run by IM-InGameTests.</Description>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!--run.py passes GameDir. Override with: dotnet build -p:GameDir="D:\SteamLibrary\steamapps\common\Idol Manager" -p:InGameTestsDir=...-->
	<PropertyGroup>
		<GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Idol Manager</GameDir>
		<GameDllDir Condition="'$(GameDllDir)' == ''">$(GameDir)\IM_Data\Managed</GameDllDir>
		<InGameTestsDir Condition="'$(InGameTestsDir)' == ''">$(IM_INGAMETESTS)</InGameTestsDir>
		<InGameTestsDir Condition="'$(InGameTestsDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\IM-InGameTests</InGameTestsDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
		<PackageReference Include="UnityEngine.Modules" Version="2019.4.23" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<!--The runner: [InGameTest], TestContext, Game. Building this project builds and deploys it too.-->
		<ProjectReference Include="$(InGameTestsDir)\source\InGameTests.csproj">
			<Private>false</Private>
		</ProjectReference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameDllDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp-firstpass">
			<HintPath>$(GameDllDir)\Assembly-CSharp-firstpass.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(GameDllDir)\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>$(GameDllDir)\UnityEngine.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!--Deploy next to the runner plugin-->
	<Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
		<MakeDir Directories="$(GameDir)\BepInEx\plugins\InGameTests" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\InGameTests" />
	</Target>
</Project>
